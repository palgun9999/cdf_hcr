#include <bits/stdc++.h>
using namespace std;
int main()
{
    int T;
    cin >> T;
    while(T--)
    {
        int N;
        cin >> N;
        long long prev = 0;
        long long ans = 0;
        for(int i = 0; i < N; i++)
        {
            long long x;
            cin >> x;
            if(i % 2 == 1)
                x = -x;
            ans += abs(x - prev);
            prev = x;
            if(i == N - 1)
                ans += abs(x);
        }
        cout << ans / 2 << endl;
    }
    return 0;
}