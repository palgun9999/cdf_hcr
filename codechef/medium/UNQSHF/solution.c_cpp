#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        string a, b;
        cin >> a >> b;

        int Aa = 0, Ab = 0;
        int Ba = 0, Bb = 0;

        for (int i = 0; i < n; i++) {
            if (a[i] == 'a')
                Aa++;
            else
                Ab++;

            if (b[i] == 'a')
                Ba++;
            else
                Bb++;
        }

        if (Aa == Bb && Ab == Ba)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}