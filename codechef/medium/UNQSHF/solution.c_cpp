#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,Aa=0,Bb=0,Ab=0,Ba=0;
        cin>>n;
        string a,b;
        cin>>a;
        cin>>b;
        for(int i=0;i<n;i++)
        {
            if(a[i]=='a')
            {
                Aa++;
            }
            else
            {
                Bb++;
            }
            if(b[i]=='a')
            {
                Ba++;
            }
            else
            {
                Bb++;
            }
        }
        int res;
        if(((Aa==Ba || Aa==Bb)&&(Ab==Ba || Ab==Bb)) )
    }
}
