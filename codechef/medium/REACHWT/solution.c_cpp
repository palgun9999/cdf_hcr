#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        int c=0;
        while(n>0)
        {
            if(n%2==0)
            {
                c+=30;
                n-=2;
            }
            else
            {
                c+=20;
                n-=1;
            }
        }
        cout<<c<<endl;
    }
}
