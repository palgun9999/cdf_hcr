#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int> a(n);
        long long sum=0;
        int k=0; // count of odd-valued boxes
        for(int i=0;i<n;i++){
            cin>>a[i];
            sum+=a[i];
            if(a[i]%2!=0) k++;
        }
        long long alice;
        if(sum%2==0){
            alice = sum - k/2;
        } else {
            alice = k/2;
        }
        cout<<alice<<endl;
    }
    return 0;
}