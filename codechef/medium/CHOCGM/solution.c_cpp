#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int> s(n);
        for(int i=0;i<n;i++)
        {
            cin>>s[i];
        }
        int alice=0;
        for(int i=0;i<n;i++)
        {
            if(sum(s)%2==0)
            {
                alice+=s[max[s]];
                s[max(s)]=0;
            }
        }
        cout<<alice<<endl;
    }
    return 0;
}
