#include<bits/stdc++.h>
using namespace std;

int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int>a(n);
        int sum=0;
        int alice=0;
        for(int i=0;i<n;i++){
            cin>>a[i];
            sum+=a[i];
            if(a[i]%2==0)
                alice+=a[i];
        }
        if(sum%2!=0){
            cout<<0<<endl;
        }
        else{
            int odd=0;
            for(int i=0;i<n;i++){
                if(a[i]%2!=0)
                    odd+=a[i];
            }
            if(odd>0)
                alice+=odd-1;
            cout<<alice<<endl;
        }
    }
    return 0;
}