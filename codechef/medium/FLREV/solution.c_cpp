#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int N;
        string S;

        cin >> N;
        cin >> S;

        int transitions = 0;

        for (int i = 0; i < N - 1; i++)
        {
            if (S[i] != S[i + 1])
            {
                transitions++;
            }
        }

        int beauty = (N - 1) - transitions;

        if (transitions >= 3)
        {
            beauty += 2;
        }
        else if (transitions == 2)
        {
            beauty += 1;
        }

        cout << beauty << endl;
    }
}
