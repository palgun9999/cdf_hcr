#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int> sa(n);
        for(int i=0;i<n;i++)
        {
            cin>>sa[i];
        }
        int ans= 0;
        for(int i=0;i<n;i++)
        {
            ans=max(ans,sa[i]);
        }
        for(int i=0;i<n;i++)
        {
            for(int j=i+1;j<n;j++)
            {
                if(sa[i]<=sa[j])
                {
                    ans=max(ans,sa[i]+sa[j]);
                }
            }
        }
        cout<<ans<<endl;
    }
    return 0;
}
