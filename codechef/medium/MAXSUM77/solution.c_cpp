#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while(t--)
    {
        int n, k;
        cin >> n >> k;
        vector<int> br(n);
        for(int i = 0; i < n; i++)
        {
            cin >> br[i];
        }
        int len = n - k;
        int sum = 0;
        for(int i = 0; i < len; i++)
        {
            sum += br[i];
        }
        int ans = sum;
        for(int i = len; i < n; i++)
        {
            sum += br[i];
            sum -= br[i - len];
            ans = max(ans, sum);
        }
        cout << ans << endl;
    }
    return 0;
}