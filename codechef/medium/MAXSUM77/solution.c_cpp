#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,k;
        cin>>n>>k;
        vector<int> br(n);
        for(int i=0;i<n;i++)
        {
            cin>>br[i];
        }
        while(k>0)
        {
            if(br[0]<br[n-1])
            {
                br.erase(br.begin());
                k--;
            }
            else
            {
                br.erase(br.end());
                k--;
            }
        }
        int sum=0;
        for(int i=0;i<br.size();i++)
        {
            sum+=br[i];
        }
        cout<<sum<<endl;
    }
    return 0;
}
