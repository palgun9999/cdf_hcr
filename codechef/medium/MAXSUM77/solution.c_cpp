#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,k;
        cin>>n>>k;
        int sum=0;
        vector<int> br(n);
        for(int i=0;i<n;i++)
        {
            cin>>br[i];
        }
        int len=n-k;
        for(int i=0;i<n;i++)
        {
            sum+=br[i];
        }
        int res=sum;
        for(int i=len;i<n;i++)
        {
            sum+=br[i];
            sum-=br[i-len];
            res=max(res,sum);
        }
        cout<<res<<endl;
    }
    return 0;
}
