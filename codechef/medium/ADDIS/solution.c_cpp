#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t;
    cin >> t;

    while(t--)
    {
        int n;
        cin >> n;

        vector<int> sa(n);
        vector<int> dw;

        for(int i = 0; i < n; i++)
        {
            cin >> sa[i];

            if(i % 2 == 0)
                dw.push_back(sa[i]);
            else
                dw.push_back(-sa[i]);
        }

        map<int, int> ik;

        for(int i = 0; i < n; i++)
        {
            ik[dw[i]]++;
        }

        int a = 0;

        for(auto x : ik)
        {
            a = max(a, x.second);
        }

        cout << a << endl;
    }
}