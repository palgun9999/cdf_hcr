#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin >> t;
    while(t--)
    {
        int n, k;
        cin >> n >> k;
        vector<int> sa(n);
        for(int i = 0; i < n; i++)
        {
            cin >> sa[i];
        }
        int ans = INT_MAX;
        for(int i = 0; i < n; i++)
        {
            for(int j = i + 1; j < n; j++)
            {
                vector<int> covered(n + 1, 0);
                int l1 = max(1, i + 1 - k);
                int r1 = min(n, i + 1 + k);
                int l2 = max(1, j + 1 - k);
                int r2 = min(n, j + 1 + k);
                for(int p = l1; p <= r1; p++)
                    covered[p] = 1;
                for(int p = l2; p <= r2; p++)
                    covered[p] = 1;
                bool ok = true;
                for(int p = 1; p <= n; p++)
                {
                    if(!covered[p])
                    {
                        ok = false;
                        break;
                    }
                }
                if(ok)
                {
                    ans = min(ans, sa[i] + sa[j]);
                }
            }
        }
        if(ans == INT_MAX)
            cout << -1 << endl;
        else
            cout << ans << endl;
    }
    return 0;
}
