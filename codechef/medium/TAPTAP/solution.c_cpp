#include <bits/stdc++.h>
using namespace std;

const long long MOD = 998244353;

void solve()
{
    int n;
    long long g;
    cin >> n >> g;

    vector<long long> a(n);

    for(int i = 0; i < n; i++)
        cin >> a[i];

    vector<long long> dp(n, 0);

    dp[0] = 2;

    for(int i = 1; i < n; i++)
    {
        if(a[i] - a[i - 1] < g)
            dp[i] = dp[i - 1];
        else
            dp[i] = (2 * dp[i - 1]) % MOD;
    }
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;

    while(t--)
        solve();

    return 0;
}