#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
        
        for (int l = 0; l < n; l++) {
            for (int r = l + 1; r < n; r++) {
                int prefmax = a[l];
                int prefcnt = 1;
                for (int i = l + 1; i <= r; i++) {
                    if (a[i] >= prefmax) {
                        prefmax = a[i];
                        prefcnt++;
                    }
                }
                
                int suffmax = a[r];
                int suffcnt = 1;
                for (int i = r - 1; i >= l; i--) {
                    if (a[i] >= suffmax) {
                        suffmax = a[i];
                        suffcnt++;
                    }
                }
                
                if (prefcnt == suffcnt) {
                    cout << l + 1 << " " << r + 1 << endl;
                    goto next;
                }
            }
        }
        
        cout << -1 << endl;
        
        next:;
    }
    return 0;
}