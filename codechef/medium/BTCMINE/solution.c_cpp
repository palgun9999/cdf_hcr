#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        long long x, y;
        cin >> x >> y;

        long long ans = LLONG_MAX;

        for (long long k = 1; k <= 100; k++) {
            long long profit = y * k * (k + 1) * (2 * k + 1) / 6 - x * k;
            long long days = k;

            if (profit <= 0) {
                long long gain = y * k * k;
                days += (-profit) / gain + 1;
            }

            ans = min(ans, days);
        }

        cout << ans << endl;
    }

    return 0;
}