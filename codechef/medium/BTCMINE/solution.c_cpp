#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        long long X, Y;
        cin >> X >> Y;

        for (long long d = 1; ; d++) {
            long long mining = Y * d * (d + 1) * (2 * d + 1) / 6;
            long long cost = X * d;

            if (mining > cost) {
                cout << d << '\n';
                break;
            }
        }
    }

    return 0;
}