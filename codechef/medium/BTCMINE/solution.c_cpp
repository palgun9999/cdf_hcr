#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;

    while(t--)
    {
        long long X, Y, profit = 0, gpu = 0;
        int days = 0;
        while (profit <= 0) 
        {
            days++;
            gpu++;
            profit += Y * gpu * gpu - X;
        }
        cout << days << endl;
    }
    return 0;
}