#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int x, y;
        cin >> x >> y;

        vector<long long> dp(205, -1);
        dp[0] = 0;

        for (int day = 1;; day++) {
            vector<long long> ndp(205, -1);

            for (int k = 0; k <= day; k++) {
                if (dp[k] >= 0)
                    ndp[k] = max(ndp[k], dp[k] + 1LL * y * k * k);

                if (k > 0 && dp[k - 1] >= 0)
                    ndp[k] = max(ndp[k], dp[k - 1] - x + 1LL * y * k * k);
            }

            dp = ndp;

            long long best = 0;
            for (long long p : dp)
                best = max(best, p);

            if (best > 0) {
                cout << day << '\n';
                break;
            }
        }
    }

    return 0;
}