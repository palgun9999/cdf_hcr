#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;

    while(t--)
    {
        long long n;
        cin >> n;
        if(n % 3 == 1)
        {
            cout << n << endl;
        }
        else
        {
            cout << 3 * ((n + 1) / 3) + 1<<endl;
        }
    }
    return 0;
}