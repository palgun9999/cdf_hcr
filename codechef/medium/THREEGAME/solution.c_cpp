#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        int r=0;
        int f=0,s=0,t=0;
        while(n>0)
        {
            if(f==s && f==t)
            {
                f++;
            }
            else if(s==t)
            {
                s++;
            }
            else
            {
                t++;
            }
            r++;
            n--;
        }
        if(f==s && f==t)
        {
            r++;
        }
        cout<<r<<endl;
    }
}
