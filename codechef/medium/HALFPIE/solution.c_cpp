#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int> V(n);
        for(int i=0;i<n;i++)
        {
            cin>>V[i];
        }
        sort(V.begin(),V.end());
        int sum+=V[0]/2;
        sum+=V[1]/2;
        for(int i=2;i<n;i++)
        {
            sum+=V[i];
        }
        cout<<sum<<endl;
    }
    return 0;
}
