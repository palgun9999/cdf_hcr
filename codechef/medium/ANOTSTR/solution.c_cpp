#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin >> t;
    while (t--) 
    {
        int n;
        string a, b;
        cin >> n >> a >> b;
        int ca = count(a.begin(), a.end(), '1');
        int cb = count(b.begin(), b.end(), '1');
        cout << ((ca % 2 == cb % 2) ? "YES" : "NO") <<endl;
    }
    return 0;
}