#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int p,q,r,s;
        cin>>p>>q>>r>>s;
        if(p+q+r<s || p+q+s<r || p+s+r<q || q+r+s<p)
        {
            cout<<"Yes"<<endl;
        }
        else
        {
            cout<<"No"<<endl;
        }
    }
    return 0;
}
