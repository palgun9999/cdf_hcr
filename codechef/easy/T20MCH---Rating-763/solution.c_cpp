#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        int c=0;
        while(n>0)
        {
            if(n-1!=0)
            {
                c++;
            }
            n-=7;
        }
        cout<<c<<endl;
    }
}
