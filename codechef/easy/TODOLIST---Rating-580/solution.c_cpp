#include<iostream>
#include<vector>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int> sa(n);
        int c=0;
        for(int i=0;i<n;i++)
        {
            cin>>sa[i];
            if(sa[i]>=1000)
            {
                c++;
            }
        }
        cout<<c<<endl;
    }
    return 0;
}
