#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,x,c=0;
        cin>>n>>x;
        vector<int> s(n);
        for(int i=0;i<n;i++)
        {
            cin>>s[i];
            if(s[i]>=x)
            {
                c++;
            }
        }
        cout<<c<<endl;
        
    }
}
