#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int x,n,c=0;
        cin>>x>>n;
        while(n>0)
        {
            if(x<=0)
            {
                c++;
            }
            n-=100;
            x--;
        }
        cout<<c<<endl;
    }
    return 0;
}
