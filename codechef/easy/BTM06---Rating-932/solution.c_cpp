#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int A, B;
    A = 5; // 5 = 101 in Binary
    B = 11; // 11 = 1011 in Binary

    int AND = A & B; // 0101 & 1011
    int OR = A | B; // 0101 | 1011

    cout << "The Bitwise AND is: " << (A & B) << "\n";
    cout << "The Bitwise OR is: " << (A | B) << "\n";
    
    return 0;
}