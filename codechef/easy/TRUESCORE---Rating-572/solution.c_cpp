#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int a,b,c,d;
        cin>>a>>b>>c>>d;
        if((a-c)>0 || (b-d)>0)
        {
            cout<<"IMPOSSIBLE"<<endl;
        }
        else
        {
            cout<<"POSSIBLE"<<endl;
        }
    }
    return 0;
}
