#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,a,b;
        cin>>n>>a>>b;
        int res;
        if(n%2==0)
        {
            res=((n/2)*a)+((n/2)*b);
        }
        else
        {
            res=(((n-1)/2)*a)+(((n+1)/2)*b);
        }
        cout<<res<<endl;
    }
    return 0;
}
