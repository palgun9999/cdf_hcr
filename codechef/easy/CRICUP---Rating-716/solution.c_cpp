#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,c=0;
        cin>>n;
        vector<int> sadviee(n);
        for(int i=0;i<n;i++)
        {
            cin>>sadviee[i];
            if(sadviee[i]>=10 && sadviee[i]<=60)
            {
                c++;
            }
        }
        cout<<c<<endl;
    }
    return 0;
}
