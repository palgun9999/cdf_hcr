#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<int> Sa(n);
        int c=0;
        for(int i=0;i<n;i++)
        {
            cin>>Sa[i];
            if(Sa[i]==-1)
            {
                c++;
            }
        }
        if(n%2!=0)
        {
            cout<<-1<<endl;
        }
        else
        {
            cout<<n/2-c<<endl;
        }
    }
    return 0;
}
