#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int a,b,c;
        cin>>a>>b>>c;
        int cnt=0;
        while(a<=b && c<=b)
        {
            cnt++;
            c++;
            a++;
            if(cnt==1)
            {
                break;
            }
        }
        if(cnt>0)
        {
            cout<<"Yes"<<endl;
        }
        else
        {
            cout<<"No"<<endl;
        }
    }
    return 0;
}
