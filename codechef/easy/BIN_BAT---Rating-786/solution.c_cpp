#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,a,b;
        cin>>n>>a>>b;
        int res=0;
        while(n>1)
        {
            n/=2;
            res+=(a+b);
        }
        res-=b;
        cout<<res<<endl;
    }
    return 0;
}
