#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        vector<string> code(n);
        int st=0,lt=0;
        for(int i=0;i<n;i++)
        {
            cin>>code[i];
            if(code[i]=="START38")
            {
                st++;
            }
            else
            {
                lt++;
            }
        }
        cout<<st<<" "<<lt<<endl;
    }
    return 0;
}
