#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int x,y,step=0,c=0;
        cin>>x>>y;
        while(step!=x)
        {
            c++;
            if(step+y<=x)
            {
                step+=y;
            }
            else
            {
                step+=1;
            }
        }
        cout<<c<<endl;
    }
    return 0;
}
