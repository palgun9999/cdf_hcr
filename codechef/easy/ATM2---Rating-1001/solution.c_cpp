#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,k;
        cin>>n>>k;  
        vector<int> V(n);
        vector<int> res; 
        for(int i=0;i<n;i++)
        {
            cin>>V[i];
            if(V[i]<=k && k>0)  
            {
                k-=V[i]; 
                res.push_back(1); 
            }
            else
            {
                res.push_back(0);
            }
        }
        for(int i=0;i<n;i++)
        {
            cout<<res[i];
        }
        cout<<endl;
    }
    return 0;
}
