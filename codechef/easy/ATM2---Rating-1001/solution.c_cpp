#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,k;
        cin>>n>>k;  //5 10
        vector<int> V(n); //3 5 3 2 1
        vector<int> res; // 1 1 0 1
        for(int i=0;i<n;i++)
        {
            cin>>V[i];
            if(V[i]<=k && k>0)  //0<=0
            {
                k-=V[i]; //0
                res.push_back(1); //
            }
            else
            {
                res.push_back(0);
            }
        }
        for(int i=0;i<n;i++)
        {
            cout<<res[i];
        }
        cout<<endl;
    }
    return 0;
}
