#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int a,b,k;
        cin>>a>>b>>k;
        int c=0;
        if(a==b)
        {
            cout<<0<<endl;
            continue;
        }
        if(a<b) // 10<20
        {
            while(a<b) 
            {
                b-=k;
                c++;
            }
        }
        else
        {
            while(a>b)
            {
                b+=k;
                c++;
            }
        }
        cout<<c<<endl;
    }
}
