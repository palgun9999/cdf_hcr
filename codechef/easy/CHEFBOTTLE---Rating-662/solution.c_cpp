#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,x,k,i=0;
        cin>>n>>x>>k;
        while(k>0)
        {
            if(i==n)
            {
                break;
            }
            if(x>k)
            {
                break;
            }
            i++;
            k-=x;
        }
        cout<<i<<endl;
    }
    return 0;
}
