#include<iostream>
using namespace std;
bool isprime(int n)
{
    if(n==1)
    {
        return true;
    }
    bool fc=0;
    for(int i=2;i*i<=n;i++)
    {
        if(n%i==0)
        {
            fc=1;
            break;
        }
    }
    return fc;
}
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        if(!isprime(n))
        {
            cout<<"yes"<<endl;
        }
        else
        {
            cout<<"no"<<endl;
        }
    }
    return 0;
}