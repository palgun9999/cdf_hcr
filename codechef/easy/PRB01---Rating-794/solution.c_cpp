#include <bits/stdc++.h>
using namespace std;
bool isprime(int n)
{
    if(n==1)
    {
        return false;
    }
    int c=2;
    for(int i=2;i<n;i++)
    {
        if(n%i==0)
        {
            c++;
        }
    }
    return c==2;
}
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;
        if(isprime(n))
        {
            cout<<"yes"<<endl;
        }
        else
        {
            cout<<"no"<<endl;
        }
    }
    return 0;
}
