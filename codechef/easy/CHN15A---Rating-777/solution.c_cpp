#include <bits/stdc++.h>
using namespace std;
int main() 
{
   int t;
   cin>>t;
   while(t--)
   {
       int n,k;
       cin>>n>>k;
       vector<int> sa(n);
       int c=0;
       for(int i=0;i<n;i++)
       {
           cin>>sa[i];
           if((sa[i]+k)%7==0)
           {
               c++;
           }
       }
       cout<<c<<endl;
   }
   return 0;
}
