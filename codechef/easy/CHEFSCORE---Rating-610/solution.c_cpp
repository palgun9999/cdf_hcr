#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int n,x,y,c=0;
        cin>>n>>x>>y;
        for(int i=0;i<=n;i++)
        {
            if(i*x==y)
            {
                c++;
                cout<<"YES"<<endl;
                break;
            }
        }
        if(c==0)
        {
            cout<<"NO"<<endl;
        }
    }
    return 0;
}
