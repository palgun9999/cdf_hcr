#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int a,b,flag=0,res;
        cin>>a>>b;
        for(int i=1;i<=10;i++)
        {
            if(a+b+i==21)
            {
                flag=1;
                res=i;
                break;
            }
        }
        if(flag==1)
        {
            cout<<res<<endl;
        }
        else
        {
            cout<<-1<<endl;
        }
        
    }
    return 0;
}
