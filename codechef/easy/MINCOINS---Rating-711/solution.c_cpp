#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int x;
        cin>>x;
        int res;
        if(x%5!=0)
        {
            cout<<-1<<endl;
        }
        else
        {
            res=x/10;
            if(x%10==0)
            {
                res=x/10;
            }
            else if((res*10)+5==x || (res*10)-5==x)
            {
                res=(x/10)+1;
            }
            cout<<res<<endl;
        }
    }
    return 0;
}
