#include <bits/stdc++.h>
using namespace std;
int main() 
{
    int t;
    cin>>t;
    while(t--)
    {
        int x,y,r;
        cin>>x>>y>>r;
        int res=0;
        x+=r/30;
        while(x>0)
        {
            res+=1;
            x-=y;
        }
        cout<<res<<endl;
    }
    return 0;
}
